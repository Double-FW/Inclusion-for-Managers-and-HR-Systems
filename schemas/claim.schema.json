{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "canonical_path": {
      "type": "string",
      "minLength": 1
    },
    "qualification": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewed_on": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    }
  },
  "required": [
    "id",
    "claim",
    "source_ids",
    "canonical_path",
    "qualification",
    "review_status",
    "reviewer",
    "reviewed_on"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/inclusive-employment/claim.schema.json",
  "title": "claim",
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "approved"
          }
        }
      },
      "then": {
        "properties": {
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_on": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  ]
}
