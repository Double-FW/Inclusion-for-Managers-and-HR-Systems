{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^IE-[A-Z]{2,3}-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "authority_type": {
      "enum": [
        "law",
        "regulator_guidance",
        "organisational_policy",
        "double_fw_method",
        "research",
        "practice_example"
      ]
    },
    "directive": {
      "enum": [
        "must",
        "should",
        "may"
      ]
    },
    "adoption_status": {
      "enum": [
        "proposed",
        "adopted"
      ]
    },
    "audiences": {
      "type": "array",
      "items": {
        "enum": [
          "hiring_managers",
          "hr",
          "line_managers",
          "teams",
          "employees",
          "leaders"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "lifecycle_stages": {
      "type": "array",
      "items": {
        "enum": [
          "recruitment",
          "onboarding",
          "daily_work",
          "progression",
          "absence_return",
          "exit"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "settings": {
      "type": "array",
      "items": {
        "enum": [
          "remote",
          "hybrid",
          "onsite"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "barriers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "owner_role": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "enum": [
        "W1",
        "W2",
        "W3",
        "W4",
        "W5"
      ]
    },
    "canonical_path": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "verification": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "enum": [
        "draft",
        "approved",
        "retired"
      ]
    },
    "reviewed_on": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "review_due": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "title",
    "authority_type",
    "directive",
    "adoption_status",
    "audiences",
    "lifecycle_stages",
    "settings",
    "jurisdiction",
    "statement",
    "outcome",
    "barriers",
    "owner_role",
    "workflow_id",
    "canonical_path",
    "limitations",
    "source_ids",
    "verification",
    "review_status",
    "reviewed_on",
    "review_due",
    "reviewer"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/inclusive-employment/guidance.schema.json",
  "title": "guidance",
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "approved"
          }
        }
      },
      "then": {
        "properties": {
          "reviewed_on": {
            "type": "string",
            "format": "date"
          },
          "review_due": {
            "type": "string",
            "format": "date"
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
